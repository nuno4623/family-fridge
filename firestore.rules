rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(familyId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    match /families/{familyId} {
      // 가족 만들기: 만든 사람이 곧 첫 멤버여야 함
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 1;

      allow read: if isMember(familyId);

      // 멤버는 자유롭게 수정, 비멤버는 '자기 자신을 members에 추가'하는 변경만 허용 (초대코드 참여)
      allow update: if isMember(familyId)
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members);

      match /{document=**} {
        allow read, write: if isMember(familyId);
      }
    }

    // 초대코드 → familyId 조회용. 코드를 아는 사람만 get 가능 (list 불가)
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && isMember(request.resource.data.familyId);
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
